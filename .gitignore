# OS
.DS_Store

# Scraped output is versioned (stackin-bot commits new files each run).
# If you want to exclude something specific, add it below.


# Selenium
*.log
chromedriver
geckodriver

# Certificates, private keys and env files (stackin-io/devops#47).
# A1 certificates (.pfx/.p12) and private keys must never be committed:
# a pushed secret is leaked for good, history rewrites don't undo it.
*.pfx
*.p12
*.pem
*.key
*.jks
*.keystore
*.p8
.env.*
!.env.example
