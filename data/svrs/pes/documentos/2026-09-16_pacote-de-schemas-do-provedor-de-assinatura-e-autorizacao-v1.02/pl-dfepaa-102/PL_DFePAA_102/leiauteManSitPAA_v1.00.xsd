<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.portalfiscal.inf.br/paa" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" targetNamespace="http://www.portalfiscal.inf.br/paa" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="tiposGeralPAA_v1.00.xsd"/>
	<xs:simpleType name="TVersao">
		<xs:annotation>
			<xs:documentation> Tipo Versão</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="1\.00"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="TManSitPAA">
		<xs:annotation>
			<xs:documentation>Schema XML de validação da área de dados da mensagem de manutenção da Situação do vínculo PAA com contribuinte</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="verAplic" type="TVerAplic">
				<xs:annotation>
					<xs:documentation>Versão do Aplicativo solicitante</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CNPJPAA" type="TCnpj">
				<xs:annotation>
					<xs:documentation>CNPJ do Provedor de Assinatura e Autorização</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:choice>
				<xs:element name="CNPJEmit" type="TCnpj">
					<xs:annotation>
						<xs:documentation>CNPJ do Emitente vinculado ao PAA</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CPFEmit" type="TCpf">
					<xs:annotation>
						<xs:documentation>CPF do Emitente vinculado ao PAA</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
			<xs:element name="tpMan">
				<xs:annotation>
					<xs:documentation>Informa o tipo de manutenção:
1 - Desvincular
2 - Reativar vínculo </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:unsignedInt">
						<xs:enumeration value="1"/>
						<xs:enumeration value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="dReg">
				<xs:annotation>
					<xs:documentation>Data da informação cadastral</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="TData"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="xJust" type="TJust">
				<xs:annotation>
					<xs:documentation>Justificativa da alteração</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="versao" type="TVersao" use="required"/>
	</xs:complexType>
	<xs:complexType name="TRetManSitPAA">
		<xs:annotation>
			<xs:documentation>Schema XML de validação de retorno da mensagem de manutenção da Situação do vínculo PAA com contribuinte</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="verAplic" type="TVerAplic">
				<xs:annotation>
					<xs:documentation>Versão do Aplicativo </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="cStat" type="TStat">
				<xs:annotation>
					<xs:documentation>código do status da resposta</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="xMotivo" type="TMotivo">
				<xs:annotation>
					<xs:documentation>descrição literal do status</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dhResp">
				<xs:annotation>
					<xs:documentation>Data e hora da resposta no formato AAAA-MM-DDThh:mm:ss</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="NSUPAA" type="TNSU" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Número Sequencial Único da operação</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="versao" type="TVersao" use="required"/>
	</xs:complexType>
</xs:schema>