s:documentation>					</xs:annotation>				</xs:element>			</xs:choice>			<xs:element name="ultNSU" type="TNSU">				<xs:annotation>					<xs:documentation>último NSU recebido, caso seja informado com zero, o Ambiente do PAA tentará localizar o primeiro registro existente.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="NSUFin" type="TNSU" minOccurs="0">				<xs:annotation>					<xs:documentation>NSU Final que poderá ser retornado nesta requisição.Campo opcional, se não for informado o serviço de distribuição irá retornar os próximos 50 NSU de busca disponíveis a partir do ultNSU informado</xs:documentation>				</xs:annotation>			</xs:element>		</xs:sequence>		<xs:attribute name="versao" type="TVerDFe" use="required"/>	</xs:complexType>	<xs:complexType name="TRetDistPAA">		<xs:annotation>			<xs:documentation>Schema XML de retorno do pedido de compartilhamento do vínculo do PAA com contribuinte</xs:documentation>		</xs:annotation>		<xs:sequence>			<xs:element name="verAplic" type="TVerAplic">				<xs:annotation>					<xs:documentation>Versão da aplicação do serviço de compartilhamento da SVRS</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="cStat" type="TStat">				<xs:annotation>					<xs:documentation>Código do status de resultado da pesquisa</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="xMotivo" type="TMotivo">				<xs:annotation>					<xs:documentation>Descrição do resultado do pesquisa</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="ultNSU" type="TNSU" minOccurs="0">				<xs:annotation>					<xs:documentation>último NSU</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="ultNSUSVD" type="TNSU" minOccurs="0">				<xs:annotation>					<xs:documentation>último NSU para a UF na SVD</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="lotePAA" minOccurs="0">				<xs:annotation>					<xs:documentation>Conjunto de vínculos correspondentes aos NSU solicitados. 		</xs:documentation>				</xs:annotation>				<xs:complexType>					<xs:sequence maxOccurs="50">						<xs:element name="infPAA">							<xs:annotation>								<xs:documentation>Grupo de informações do vínculo PAA </xs:documentation>							</xs:annotation>							<xs:complexType>								<xs:sequence>									<xs:element name="CNPJPAA" type="TCnpj">										<xs:annotation>											<xs:documentation>CNPJ do Provedor de Assinatura e Autorização</xs:documentation>										</xs:annotation>									</xs:element>									<xs:choice>										<xs:element name="CNPJEmit" type="TCnpj">											<xs:annotation>												<xs:documentation>CNPJ do Emitente vinculado ao PAA</xs:documentation>											</xs:annotation>										</xs:element>										<xs:element name="CPFEmit" type="TCpf">											<xs:annotation>												<xs:documentation>CPF do Emitente vinculado ao PAA</xs:documentation>											</xs:annotation>										</xs:element>									</xs:choice>									<xs:element name="dSit" type="TData">										<xs:annotation>											<xs:documentation>Data do registro correspondente ao NSU Movto</xs:documentation>										</xs:annotation>									</xs:element>									<xs:element name="codSit">										<xs:annotation>											<xs:documentation>Situação do vínculo correspondente a posição atual do cadastro</xs:documentation>											<xs:documentation>Situação do vínculo correspondente a posição atual do cadastro entre PAA e Contribuinte0 - Desvinculado por comando do Contribuinte1 - Vínculo Ativo2 - Desvinculado por comando do PAA3 - Desvinculado por comando da Administração Tributária</xs:documentation>										</xs:annotation>										<xs:simpleType>											<xs:restriction base="TString">												<xs:enumeration value="0"/>												<xs:enumeration value="1"/>												<xs:enumeration value="2"/>												<xs:enumeration value="3"/>											</xs:restriction>										</xs:simpleType>									</xs:element>									<xs:element name="gChavesPAA">										<xs:complexType>											<xs:sequence>												<xs:element name="gChavePrivada">													<xs:complexType>														<xs:sequence>															<xs:element name="RSAKeyValue" type="TRSAPrivKeyValueType"/>														</xs:sequence>													</xs:complexType>												</xs:element>												<xs:element name="gChavePublica">													<xs:complexType>														<xs:sequence>															<xs:element name="RSAKeyValue" type="TRSAPubKeyValueType">																<xs:annotation>																	<xs:documentation>Chave pública RSA para assinatura avançada do contribuinte</xs:documentation>																</xs:annotation>															</xs:element>														</xs:sequence>													</xs:complexType>												</xs:element>											</xs:sequence>										</xs:complexType>									</xs:element>								</xs:sequence>								<xs:attribute name="NSUPAA" type="TNSU" use="required">									<xs:annotation>										<xs:documentation>Número sequencial único do registro de inclusão do vínculo PAA x MEI </xs:documentation>									</xs:annotation>								</xs:attribute>							</xs:complexType>						</xs:element>					</xs:sequence>				</xs:complexType>			</xs:element>		</xs:sequence>		<xs:attribute name="versao" type="TVerDFe" use="required"/>	</xs:complexType>	<xs:complexType name="TRSAPubKeyValueType">		<xs:annotation>			<xs:documentation>Tipo que representa uma chave publica padrão RSA</xs:documentation>		</xs:annotation>		<xs:sequence>			<xs:element name="Modulus" type="xs:base64Binary"/>			<xs:element name="Exponent">				<xs:simpleType>					<xs:restriction base="xs:string">						<xs:enumeration value="AQAB"/>					</xs:restriction>				</xs:simpleType>			</xs:element>		</xs:sequence>	</xs:complexType>	<xs:complexType name="TRSAPrivKeyValueType">		<xs:annotation>			<xs:documentation>Tipo que representa uma chave privada padrão RSA</xs:documentation>		</xs:annotation>		<xs:sequence>			<xs:element name="Modulus" type="xs:base64Binary"/>			<xs:element name="Exponent">				<xs:simpleType>					<xs:restriction base="xs:string">						<xs:enumeration value="AQAB"/>					</xs:restriction>				</xs:simpleType>			</xs:element>			<xs:element name="P" type="xs:base64Binary"/>			<xs:element name="Q" type="xs:base64Binary"/>			<xs:element name="DP" type="xs:base64Binary"/>			<xs:element name="DQ" type="xs:base64Binary"/>			<xs:element name="InverseQ" type="xs:base64Binary"/>			<xs:element name="D" type="xs:base64Binary"/>		</xs:sequence>	</xs:complexType></xs:schema>